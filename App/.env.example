# Copy to .env and fill with real values. Do not commit secrets or put the
# service-role key in the Expo app environment.

# Supabase project URL and public anon/publishable key.
EXPO_PUBLIC_SUPABASE_URL=https://api.keepitback.in
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Edge Function secrets (set with `npx supabase secrets set`, not in this file)
# LINK_CODE_SECRET=          # random secret for one-time Instagram link codes
# META_APP_SECRET=           # Instagram Messaging webhook signature secret
# META_VERIFY_TOKEN=         # token for the webhook handshake
# META_TOKEN=                # optional: enables confirmation replies in DMs
# META_IG_USER_ID=           # optional: Instagram professional account id
