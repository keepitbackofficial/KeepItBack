# KeepItBack — environment template
# Copy to .env and fill in real values. NEVER commit real secrets; never put
# service-role or Meta keys in the mobile client bundle.

# --- Clerk (identity provider) ---------------------------------------------
# Publishable key from https://dashboard.clerk.com → your app → API Keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Keep any Clerk secret key in a server-side secret store only. Do not add it
# to this Expo app's .env file because it can be embedded in client builds.

# --- Supabase (application data) -------------------------------------------
# Project URL + public anon key. The service-role key must NOT be set here
# for the app — Edge Functions read it from their own runtime environment.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase Edge Function secrets (set via `supabase secrets set`, not .env)
# LINK_CODE_SECRET=          # HMAC key for one-time link codes (random, 32+ chars)
# CLERK_JWKS_URL=            # https://<app>.clerk.accounts.dev/.well-known/jwks.json
# META_APP_SECRET=           # Instagram Messaging webhook signature secret
# META_VERIFY_TOKEN=         # token for the webhook handshake (you choose)
# META_TOKEN=                # optional: enables confirmations in the DM thread
# META_IG_USER_ID=           # optional: your IG professional account id
