{
  "expo": {
    "name": "KeepItBack",
    "slug": "keepitback",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.app.keepitback"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.app.keepitback"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-status-bar",
      "@clerk/expo",
      "expo-secure-store",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ],
          "iosAppGroupIdentifier": "group.in.app.keepitback",
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1
          }
        }
      ]
    ],
    "scheme": "keepitback",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ShareExtension",
                  "bundleIdentifier": "in.app.keepitback.share-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.in.app.keepitback"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "9920f082-4b0b-49d7-892b-18400ed329cc"
      }
    },
    "owner": "keepitback"
  }
}
